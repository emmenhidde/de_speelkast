<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Alleen de bestaande categorieën zijn toegestaan -->
    <xs:simpleType name="categoryType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Kaartspel"/>
            <xs:enumeration value="Bordspel"/>
            <xs:enumeration value="Dobbelspel"/>
            <xs:enumeration value="Rollenspel"/>
            <xs:enumeration value="Behendigheidsspel"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Alle hoofdspelvelden zijn verplicht -->
    <xs:complexType name="gameType">
        <xs:all>
            <xs:element name="id" type="xs:positiveInteger"/>
            <xs:element name="category" type="categoryType"/>
            <xs:element name="title" type="xs:string"/>
            <xs:element name="photo_path" type="xs:string"/>
            <xs:element name="min_max_players" type="xs:string"/>
            <xs:element name="is_board_game" type="xs:boolean"/>
            <xs:element name="board_format" type="xs:string"/>
            <xs:element name="owner_main" type="xs:string" minOccurs="0"/>
        </xs:all>
    </xs:complexType>

    <!-- Een uitbreiding mag zonder het hoofdspel in de export staan -->
    <xs:complexType name="extensionType">
        <xs:all>
            <xs:element name="id" type="xs:positiveInteger"/>
            <xs:element name="base_game" type="xs:positiveInteger"/>
            <xs:element name="extension_name" type="xs:string"/>
            <xs:element name="extend_photo_path" type="xs:string"/>
            <xs:element name="min_max_extend_players" type="xs:string"/>
            <xs:element name="extend_is_boardgame" type="xs:boolean"/>
            <xs:element name="extend_board_size" type="xs:string"/>
            <xs:element name="owner_extension" type="xs:string" minOccurs="0"/>
        </xs:all>
    </xs:complexType>

    <!-- De export mag leeg zijn of meerdere hoofdspellen en uitbreidingen bevatten -->
    <xs:element name="games">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="game" type="gameType"/>
                <xs:element name="extension" type="extensionType"/>
            </xs:choice>
        </xs:complexType>

        <xs:unique name="uniqueGameId">
            <xs:selector xpath="game"/>
            <xs:field xpath="id"/>
        </xs:unique>
        <xs:unique name="uniqueExtensionId">
            <xs:selector xpath="extension"/>
            <xs:field xpath="id"/>
        </xs:unique>
        
    </xs:element>

</xs:schema>